            <a:Outboxtaglist xmlns:b="http://schemas.microsoft.com/2003/10/Serialization/Arrays">
              <b:string>urn:mail:defaultgb@ornek.com.tr</b:string>
            </a:Outboxtaglist>
            <a:Registrationdate>2020-01-15T00:00:00</a:Registrationdate>
