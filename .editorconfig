root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[Makefile]
indent_style = tab

[*.{yml,yaml,json,md}]
indent_style = space
indent_size = 2

# Official GİB / OASIS artefacts keep original bytes.
[*.{xml,xsd,xsl,xslt}]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false

[schemas/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false

[testdata/**]
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = false
